{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Metric Candidate Governance Lite V1",
  "type": "object",
  "required": [
    "module_id",
    "status",
    "claim_safety",
    "metric_candidate_count",
    "family_counts",
    "readiness_counts",
    "governance_gaps",
    "dependency_graph",
    "metric_value_output_allowed",
    "claim_output_allowed",
    "canonical_event_count",
    "metric_candidates"
  ],
  "properties": {
    "module_id": {"const": "metric_candidate_governance_validator_lite_v1"},
    "status": {"enum": ["SMOKE_PASS", "REVIEW_REQUIRED", "FAIL_CLOSED"]},
    "claim_safety": {"const": "METRIC_CANDIDATE_GOVERNANCE_ONLY"},
    "metric_candidate_count": {"type": "integer", "minimum": 0},
    "family_counts": {"type": "object"},
    "readiness_counts": {"type": "object"},
    "governance_gaps": {"type": "array"},
    "dependency_graph": {
      "type": "object",
      "required": ["nodes", "edges"],
      "properties": {
        "nodes": {"type": "array"},
        "edges": {"type": "array"}
      },
      "additionalProperties": true
    },
    "feature_value_output_allowed": {"const": false},
    "metric_value_output_allowed": {"const": false},
    "claim_output_allowed": {"const": false},
    "canonical_event_count": {"const": "UNKNOWN"},
    "metric_candidates": {"type": "array"}
  },
  "additionalProperties": true
}
