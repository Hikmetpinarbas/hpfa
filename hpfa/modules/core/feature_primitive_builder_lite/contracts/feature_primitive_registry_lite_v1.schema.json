{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Feature Primitive Registry Lite V1",
  "type": "object",
  "required": [
    "module_id",
    "status",
    "claim_safety",
    "registry_record_count",
    "family_counts",
    "readiness_seed_counts",
    "registry_gaps",
    "dependency_graph",
    "feature_value_output_allowed",
    "claim_output_allowed",
    "canonical_event_count",
    "registry_records"
  ],
  "properties": {
    "module_id": {"const": "feature_primitive_registry_loader_lite_v1"},
    "status": {"enum": ["SMOKE_PASS", "REVIEW_REQUIRED", "FAIL_CLOSED"]},
    "claim_safety": {"const": "FEATURE_PRIMITIVE_REGISTRY_ONLY"},
    "registry_record_count": {"type": "integer", "minimum": 0},
    "family_counts": {"type": "object"},
    "readiness_seed_counts": {"type": "object"},
    "registry_gaps": {"type": "array"},
    "dependency_graph": {
      "type": "object",
      "required": ["nodes", "edges"],
      "properties": {
        "nodes": {"type": "array"},
        "edges": {"type": "array"}
      },
      "additionalProperties": true
    },
    "feature_value_output_allowed": {"const": false},
    "claim_output_allowed": {"const": false},
    "canonical_event_count": {"const": "UNKNOWN"},
    "registry_records": {"type": "array"}
  },
  "additionalProperties": true
}
