{
  "module_id": "trackable_action_trace_candidates_lite_v1",
  "version": "1.3.0-object-centric-occurrence-binding",
  "purpose": "Select actor-bearing PLAYER/GOALKEEPER action surfaces into match-local trackable action trace candidates while preserving TEAM reflection context, quarantining unresolved surfaces, allowing only already-admitted occurrence review provenance to re-enter trace selection on a local copy, and exposing dependent object views of one admitted occurrence without support inflation.",
  "inputs": {
    "semantic_action_bundle_module_id": "semantic_role_action_bundle_candidates_lite_v1",
    "multi_family_taxonomy_module_id": "action_bundle_multi_family_review_taxonomy_lite_v1",
    "cross_role_relation_module_id": "cross_role_relation_candidate_resolver_lite_v1",
    "occurrence_admission_module_id": "action_occurrence_admission_lite_v1",
    "evidence_atom_module_id": "evidence_atom_inventory_lite_v1"
  },
  "selection_rules": {
    "occurrence_admission_runtime_gate_required": true,
    "occurrence_fail_closed_blocks_trace_runtime": true,
    "occurrence_review_required_does_not_promote_event_truth": true,
    "occurrence_local_taxonomy_rebind_only_for_admitted_occurrence_provenance": true,
    "occurrence_local_taxonomy_rebind_changes_upstream_truth": false,
    "primary_source_roles": ["PLAYER_SURFACE_CANDIDATE", "GOALKEEPER_SURFACE_CANDIDATE"],
    "team_surface_can_be_primary_trace": false,
    "primary_actor_candidate_required": true,
    "clear_cross_role_primary_selected": true,
    "clear_team_reflection_context_only": true,
    "unresolved_cross_role_surfaces_quarantined": true,
    "unmatched_team_surface_quarantined": true,
    "standalone_primary_pass_bundle_selected": true,
    "classified_multi_family_primary_bundle_selected": true,
    "unresolved_multi_family_primary_quarantined": true,
    "selection_partition_must_cover_every_action_bundle_exactly_once": true
  },
  "trace_core": {
    "fields": [
      "match_surface_binding_id",
      "source_role",
      "team_identity_candidate_id",
      "actor_identity_candidate_id",
      "period_candidate",
      "start_candidate",
      "end_candidate",
      "pos_x_candidate",
      "pos_y_candidate"
    ],
    "same_core_multi_family_grouping_is_candidate_only": true,
    "source_lineage_preserved": true,
    "reflection_lineage_preserved_separately": true,
    "provider_row_ids_preserved_as_candidates": true,
    "occurrence_candidate_count_is_diagnostic_only": true,
    "occurrence_candidate_is_not_trace_count_truth": true,
    "occurrence_bound_trace_candidate_is_event_truth": false,
    "occurrence_actor_and_opponent_trace_visibility_is_candidate_only": true
  },
  "object_centric_occurrence_binding": {
    "producer": "existing_occurrence_trace_binding",
    "parallel_object_engine_allowed": false,
    "relation_types": [
      "OCCURRENCE_HAS_PLAYER",
      "OCCURRENCE_HAS_TEAM",
      "OCCURRENCE_HAS_GOALKEEPER",
      "OCCURRENCE_HAS_OPPONENT_CONTEXT",
      "PLAYER_PARTICIPATES_IN_TRACE",
      "TEAM_PARTICIPATES_IN_TRACE",
      "GOALKEEPER_PARTICIPATES_IN_TRACE",
      "SAME_UNDERLYING_OCCURRENCE_REFLECTION",
      "DERIVED_FROM_SAME_OCCURRENCE"
    ],
    "same_underlying_occurrence_root_count_contribution": 1,
    "player_team_goalkeeper_views_are_independent_support": false,
    "reflection_view_is_independent_support": false,
    "entity_view_requires_admitted_occurrence_binding": true,
    "independence_proven_by_object_binding": false,
    "provenance_root_is_occurrence_candidate": true,
    "derivation_parents_preserve_action_bundle_lineage": true,
    "object_view_creates_event": false
  },
  "ordering_rules": {
    "same_timestamp_creates_order_truth": false,
    "source_row_order_is_temporal_truth": false,
    "consequence_classification_allowed": false,
    "sequence_link_allowed": false
  },
  "counting_rules": {
    "trace_count_is_physical_action_count": false,
    "occurrence_candidate_count_is_physical_action_count": false,
    "reflection_context_is_event_equivalence_truth": false,
    "final_double_count_suppression_admitted": false,
    "count_value_output_allowed": false,
    "object_view_count_is_independent_support_count": false
  },
  "claim_boundary": {
    "trackable_action_candidate_is_event_truth": false,
    "action_occurrence_candidate_is_event_truth": false,
    "occurrence_binding_is_event_truth": false,
    "physical_action_identity_truth": false,
    "validated_event_identity": false,
    "event_instance_count": 0,
    "cross_role_fusion_allowed": false,
    "sequence_truth": false,
    "possession_truth": false,
    "phase_truth": false,
    "tactical_truth": false,
    "canonical_event_count": "UNKNOWN",
    "true_action_count": "UNKNOWN",
    "production_release": false
  },
  "phone_output_policy": {
    "allowed_roots": ["/sdcard/Download/HPFA", "/storage/emulated/0/Download/HPFA"],
    "nested_output_error": "nested_phone_output_directory_rejected"
  },
  "mandatory_tests": [
    "test_no_sample_match_identity_leak",
    "test_current_trace_wrapper_is_occurrence_gated",
    "test_occurrence_admitted_review_bundles_become_local_trace_candidates",
    "test_occurrence_trace_binding_does_not_mutate_upstream_taxonomy",
    "test_unadmitted_review_record_is_not_rebound",
    "test_player_team_views_do_not_double_count_underlying_occurrence",
    "test_goalkeeper_team_view_dependency_preserved",
    "test_explicit_reflection_stays_same_occurrence_dependency_not_new_support",
    "test_entity_view_requires_occurrence_binding",
    "test_object_binding_never_creates_event_truth"
  ]
}
