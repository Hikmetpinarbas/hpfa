{
  "module_id": "event_derived_phase_state_lite_v1",
  "version": "1.0.1",
  "input_modules": [
    "visible_action_sequence_candidate_admission_lite_v1",
    "selected_action_consequence_surface_lite_v1",
    "selected_event_consequence_surface_lite_v1"
  ],
  "phase_classes": [
    "RESTART_VISIBLE_PHASE_CANDIDATE",
    "ATTACK_TRANSITION_VISIBLE_PHASE_CANDIDATE",
    "BUILD_UP_VISIBLE_PHASE_CANDIDATE",
    "MIDDLE_PROGRESSION_VISIBLE_PHASE_CANDIDATE",
    "FINAL_THIRD_VISIBLE_PHASE_CANDIDATE",
    "BOX_ACCESS_VISIBLE_PHASE_CANDIDATE",
    "FINISHING_VISIBLE_PHASE_CANDIDATE",
    "OPEN_PLAY_ZONE_UNRESOLVED_PHASE_CANDIDATE"
  ],
  "derivation_states": [
    "PHASE_DERIVED_PASS",
    "PHASE_DERIVED_WITH_WARNINGS",
    "PHASE_UNRESOLVED",
    "PHASE_REVIEW_REQUIRED",
    "FAIL_CLOSED"
  ],
  "transition_window_seconds": 10,
  "transition_hysteresis_visible_anchor_count": 2,
  "claim_boundary": {
    "phase_state_can_be_derived_from_validated_event_evidence": true,
    "candidate_upstream_is_validated_event_truth": false,
    "event_derived_phase_is_tactical_intent_truth": false,
    "event_derived_phase_is_off_ball_structure_truth": false,
    "cross_team_window_observes_losing_team_actions": false,
    "canonical_event_count": "UNKNOWN",
    "production_release": false,
    "cross_team_window_requires_explicit_handover_boundary": true,
    "adjacent_cross_team_sequences_alone_are_handover_evidence": false
  },
  "transition_boundary_authority": "VISIBLE_TEAM_HANDOVER_CANDIDATE",
  "transition_window_source": "visible_sequence_boundary_candidates",
  "transition_window_end_rule": "min(next_sequence_end, next_sequence_start + 10.0s)",
  "zero_span_handover_rule": "preserve_as_CROSS_TEAM_HANDOVER_ANCHOR_ONLY_CANDIDATE_not_window",
  "analyst_audit_counts": [
    "phase_review_required_segment_count",
    "phase_derived_with_warnings_segment_count",
    "zero_span_phase_segment_count",
    "event_derived_transition_context_anchor_count"
  ],
  "fail_closed_gates": [
    "duplicate_selected_action_node_id",
    "duplicate_selected_event_anchor_node_id",
    "invalid_or_missing_handover_sequence_reference",
    "handover_period_team_or_time_mismatch",
    "declared_sequence_or_boundary_count_mismatch"
  ]
}
