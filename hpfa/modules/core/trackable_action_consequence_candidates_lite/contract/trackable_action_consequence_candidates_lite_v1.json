{
  "module_id": "trackable_action_consequence_candidates_lite_v1",
  "version": "1.3.0-right-censoring-separation",
  "input_modules": {
    "trackable_action_trace": "trackable_action_trace_candidates_lite_v1",
    "evidence_atoms": "evidence_atom_inventory_lite_v1",
    "upstream_occurrence_context": "action_occurrence_admission_lite_v1 via occurrence-aware trace binding"
  },
  "purpose": "Attach claim-safe visible consequence candidates to current occurrence-aware Trackable Action trace candidates while preserving outcome-vs-censoring separation and admitted TEAM/GOALKEEPER/reflection object-context references without opening event, possession, sequence, causal or tactical truth.",
  "timeline_rules": {
    "same_period_only": true,
    "positive_time_delta_only": true,
    "same_timestamp_link_allowed": false,
    "negative_time_link_allowed": false,
    "cross_period_link_allowed": false,
    "source_row_order_is_temporal_truth": false,
    "window_seconds": [5.0, 8.0, 12.0],
    "max_follow_up_time_layers": 3,
    "full_no_visible_follow_up_requires_visible_trace_horizon_through_full_window": true,
    "incomplete_visible_trace_horizon_state": "RIGHT_CENSORED_VISIBLE_TRACE_HORIZON"
  },
  "outcome_censoring_rules": {
    "no_visible_follow_up_candidate_requires_complete_follow_up_window": true,
    "right_censored_class": "RIGHT_CENSORED_NO_VISIBLE_FOLLOW_UP_CANDIDATE",
    "terminal_support_overrides_right_censoring": true,
    "no_visible_follow_up_is_failure": false,
    "no_visible_follow_up_is_neutral_outcome": false,
    "right_censoring_is_failure": false,
    "right_censoring_is_neutral_outcome": false,
    "right_censoring_is_terminal_event": false,
    "absence_is_counterevidence": false
  },
  "support_rules": {
    "allowed_atom_classes": ["DERIVED_CONSEQUENCE_ATOM", "TERMINAL_OUTCOME_ATOM"],
    "pass_atoms_only": true,
    "exact_support_core_fields": [
      "match_surface_binding_id",
      "source_role",
      "period_candidate",
      "start_candidate",
      "end_candidate",
      "pos_x_candidate",
      "pos_y_candidate"
    ],
    "support_is_causal_truth": false
  },
  "trace_rules": {
    "allowed_source_roles": ["PLAYER_SURFACE_CANDIDATE", "GOALKEEPER_SURFACE_CANDIDATE"],
    "team_identity_candidate_required": true,
    "actor_identity_candidate_required": true,
    "one_consequence_candidate_per_trace_candidate": true,
    "trace_count_is_physical_action_count": false,
    "occurrence_bound_trace_may_anchor_consequence_candidate": true,
    "occurrence_binding_is_event_truth": false
  },
  "occurrence_binding_rules": {
    "supporting_occurrence_ids_copied_from_anchor_trace_only": true,
    "occurrence_binding_creates_causal_truth": false,
    "occurrence_binding_creates_sequence_truth": false,
    "both_participant_consequence_visibility_is_candidate_only": true,
    "team_context_refs_may_project_from_same_occurrence_binding_only": true,
    "goalkeeper_context_refs_may_project_from_same_occurrence_binding_only": true,
    "reflection_context_refs_may_project_from_same_occurrence_binding_only": true,
    "unsafe_or_claim_upgraded_context_binding_default": "REVIEW_REQUIRED_NO_CONTEXT_PROJECTION",
    "occurrence_context_is_independent_support": false,
    "goalkeeper_context_is_occurrence_participant_truth": false,
    "reflection_context_is_event_equivalence_truth": false,
    "occurrence_context_creates_event": false,
    "canonical_event_count_remains_unknown": true
  },
  "review_rules": {
    "mixed_team_same_time_first_follow_up_layer": "REVIEW_REQUIRED",
    "missing_team_visible_follow_up": "REVIEW_REQUIRED",
    "context_binding_claim_boundary_mismatch": "REVIEW_REQUIRED_NO_CONTEXT_PROJECTION"
  },
  "claim_boundary": {
    "consequence_candidate_is_causal_truth": false,
    "occurrence_consequence_binding_is_causal_truth": false,
    "occurrence_binding_is_event_truth": false,
    "occurrence_context_is_independent_support": false,
    "goalkeeper_context_is_occurrence_participant_truth": false,
    "reflection_context_is_event_equivalence_truth": false,
    "occurrence_context_creates_event": false,
    "continuation_candidate_is_possession_truth": false,
    "window_is_sequence_truth": false,
    "team_response_is_tactical_truth": false,
    "sequence_link_allowed": false,
    "event_instance_count": 0,
    "canonical_event_count": "UNKNOWN",
    "true_action_count": "UNKNOWN",
    "production_release": false
  },
  "phone_output": {
    "allowed_directories": [
      "/sdcard/Download/HPFA",
      "/storage/emulated/0/Download/HPFA"
    ],
    "nested_directory_error": "nested_phone_output_directory_rejected"
  }
}
