{
  "module_id": "cross_format_reconciliation_lite_v1",
  "contract_version": "provider_semantic_provenance_research_hardening_v2",
  "inputs": [
    "multiformat_file_inventory_lite_v1.json",
    "csv_surface_audit_lite_v1.json",
