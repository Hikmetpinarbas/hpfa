    "present_present_support_count",
    "both_missing_support_count",
    "upstream_duplicate_reflection_count",
    "local_duplicate_candidate_count",
    "field_semantics_version",
    "label_semantics_version",
    "reconciliation_status",
    "active_match_evidence_pass"
  ],
  "candidate_signature_without_id_fields": [
    "start",
    "end",
    "period",
    "action",
    "code",
    "team",
    "pos_x",
    "pos_y"
  ],
  "research_hardening_guards": {
    "R16_no_transitive_promotion": {
      "pairwise_link_is_canonical_identity": false,
      "pairwise_link_can_promote_other_links": false,
      "claim_ceiling": "DIRECT_PAIRWISE_EVIDENCE_ONLY"
    },
    "R20_temporal_attachment": {
      "start_end_role": "SOURCE_TIMELINE_EVIDENCE_ONLY",
      "football_order_truth": false,
      "same_time_simultaneity_truth": false,
      "sequence_attachment_allowed": false
    },
    "R21_counterpart_expectation": {
      "missing_counterpart_without_expectation_is_contradiction": false,
      "unresolved_state": "MISSING_COUNTERPART_EXPECTATION_UNRESOLVED"
    },
    "R23_measurement_resolution": {
      "numeric_comparison_mode": "EXACT_NORMALIZED_CANDIDATE_ONLY",
      "arbitrary_epsilon_allowed": false,
      "numeric_equality_is_semantic_equivalence_truth": false
    },
    "R24_conflict_authority": {
      "format_precedence": "NONE",
      "majority_vote_allowed": false,
      "automatic_resolution_allowed": false,
      "conflict_state": "UNRESOLVED_REVIEW_REQUIRED"
    },
    "R26_identifier_namespace": {
      "bare_id_is_global_event_identity": false,
      "cross_role_join_allowed": false,
      "same_role_shared_id_claim_ceiling": "MATCH_LOCAL_SAME_ROLE_SHARED_ID_CANDIDATE_ONLY",
      "namespace_requirements": [
        "provider_or_version_candidate",
        "match_scope",
        "source_role",
        "source_surface",
        "identifier_semantics",
        "uniqueness_evidence",
        "collision_or_reuse_policy",
        "serialization_normalization",
        "linkage_eligibility",
        "claim_ceiling"
      ]
    }
  },
  "hard_blocks": [
    "source_sha_missing",
    "runtime_sha_mismatch",
    "semantic_rule_without_source_ref",
    "candidate_signature_includes_identity_only",
    "cross_id_collision_check_disabled",
    "field_path_semantics_used_as_value_semantics",
    "token_fallback_promoted_without_review",
    "multi_anchor_conflict_resolved_fail_open",
    "derived_xlsx_surface_used_as_independent_confirmation",
    "xml_label_priority_used_without_authority_contract",
    "review_required_promoted_to_active_match_pass",
    "upstream_duplicate_lineage_lost",
    "canonical_event_count_claimed",
    "transitive_promotion_without_direct_evidence",
    "cross_role_identifier_join_forbidden",
    "identifier_namespace_collision_unresolved"
  ],
  "decision_states": [
    "PASS_ALIGNMENT_CANDIDATE",
    "PASS_WITH_WARNINGS",
    "DOWNGRADE_TO_SINGLE_SURFACE",
    "BLOCK_FUSION"
  ],
  "phone_runtime_policy": {
    "handoff_mode": "ONE_ZIP_ONLY",
    "phone_runtime_pytest": false,
    "single_pass_upstream_refresh": true,
    "nested_phone_output_allowed": false
  },
  "claim_boundary": {
    "canonical_event_count": "UNKNOWN",
    "validated_provider_semantics": false,
    "validated_event_identity": false,
    "validated_cross_format_equivalence": false,
    "validated_team_identity": false,
    "validated_player_identity": false,
    "xlsx_independent_confirmation": false,
    "aggregate_definition_truth": false,
    "sequence_truth": false,
    "phase_truth": false,
    "possession_truth": false,
    "tactical_truth": false,
    "production_release": false,
    "claim_ceiling": "CROSS_FORMAT_SURFACE_RECONCILIATION_CANDIDATE_ONLY"
  }
}
