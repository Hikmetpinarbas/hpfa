.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
dist/
build/
data/quarantine/*.parquet
data/quarantine/manifest.log
.DS_Store
data/quarantine/*.csv

# vendor repos (kept as source snapshots)
vendor/**/__pycache__/
vendor/**/*.pyc
vendor/**/.pytest_cache/
vendor/**/.mypy_cache/
vendor/**/.ruff_cache/
vendor/**/dist/
vendor/**/build/
vendor/**/*.egg-info/

# HPFA runtime outputs (repo-level)
# NOTE: root-anchored patterns; Termux paths are irrelevant here.
_out/
_diag/

# Probe / audit logs that are not SSOT
*_probe_*.txt
*_probe_v2_*.txt
validator_last.log
doctor_history.tsv.BAK_*

# Release script backups (must not drift into version control)
tools/*.BAK_*
tools/*~ 
tools/*.swp
tools/.#*

# Optional: local primary env (should not be committed)
.config/hpfa/primary.env

# HPFA diagnostics
/_diag/

# Local runtime authority and generated match/report outputs.
# Existing historical tracked artefacts are unaffected; new generated copies stay local.
/runtime/
/out/

# Raw donor/vendor snapshots are not product-tree dependencies.
/vendor/

# Nested legacy/imported product trees are not current authority.
/hpfa-main/

# Historical inbox material must be distilled into an owning product surface.
/data_inbox/

# Historical/provider match datasets do not belong in the product source tree.
/data/keepbox/
/data/quarantine/

# Historical graphics research packs are distilled into governed presentation policy.
/graphics_pack/
